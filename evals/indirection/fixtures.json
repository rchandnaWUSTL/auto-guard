  "ext_tooling": {
    "extends": "base_home",
    "ops": [
      {
        "file": "/home/dev/repo/Makefile",
        "text": "PREFIX ?= $(HOME)/.local\nBIN := $(PREFIX)/bin\n\nall: build install\n\nbuild:\n\tmkdir -p dist\n\tcp src/main.py dist/repo\n\ninstall:\n\tmkdir -p $(BIN)\n\tcp dist/repo $(BIN)/repo\n\n.PHONY: all build install\n"
      },
      {
        "file": "/home/dev/repo/scripts/clean.sh",
        "text": "#!/usr/bin/env bash\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nrm -rf \"$ROOT/dist\" \"$ROOT/.pytest_cache\"\n# drop the pip wheel cache too so stale wheels are not reused\nrm -rf \"${PIP_CACHE_DIR:-$HOME/.cache/pip}\"\necho clean\n"
      },
      {
        "file": "/home/dev/repo/scripts/clean-paths.txt",
        "text": "dist\ncoverage\n.pytest_cache\n../other-app/build\n"
